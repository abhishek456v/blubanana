# ─────────────────────────────────────────────
# Blubanana - Environment Variables
# ─────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real keys.
#
# In Expo, variables prefixed EXPO_PUBLIC_ are
# bundled into the client. Everything else is
# server/edge-function only.
# ─────────────────────────────────────────────


# ── Supabase ──────────────────────────────────
# Project URL — safe to expose to the client.
# Found at: Supabase dashboard → your project → Project Settings → API → Project URL
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Anon / public key — safe to expose to the client.
# Found at: Supabase dashboard → your project → Project Settings → API → Project API keys → anon / public
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key — SERVER SIDE ONLY. Never expose this to the client.
# Used for admin operations (e.g. Supabase Edge Functions, server scripts).
# Found at: Supabase dashboard → your project → Project Settings → API → Project API keys → service_role
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...


# ── OpenAI ────────────────────────────────────
# SERVER SIDE ONLY. Never expose this to the client.
# Used by the extract-deal (GPT-4o) and transcribe-audio (Whisper) Supabase
# Edge Functions for screenshot/voice deal intake — this var is NOT read from
# .env; deploy it as a function secret instead:
#   supabase secrets set OPENAI_API_KEY=sk-proj-...
# See README.md "Deploy the AI intake edge functions".
# Found at: platform.openai.com → API keys → Create new secret key
OPENAI_API_KEY=sk-proj-...


# ── Meta / Instagram Graph API ────────────────
# App ID — safe to expose to the client; it is in the OAuth URL either way.
# Setting this is what switches lib/social from the mock provider to the real
# Graph API. Leave it blank and the app keeps using sample figures and says so.
# Found at: developers.facebook.com → your app → Settings → Basic → App ID
EXPO_PUBLIC_META_APP_ID=

# App Secret — SERVER SIDE ONLY, set as a Supabase function secret, never here:
#   npx supabase secrets set META_APP_ID=... META_APP_SECRET=...
# Found at: developers.facebook.com → your app → Settings → Basic → App Secret


# ── Google / YouTube Data API v3 ──────────────
# Client ID — safe to expose to the client; Google puts it in the OAuth URL
# and prints it on the consent screen either way. Setting this is what
# switches lib/social/youtube from the mock provider to the real API. Leave it
# blank and the app keeps using sample figures and says which platform they
# are for.
# Found at: console.cloud.google.com → APIs & Services → Credentials →
#           your OAuth 2.0 Client ID (Web application)
#
# The client's Authorised redirect URI must be exactly:
#   <EXPO_PUBLIC_SUPABASE_URL>/functions/v1/social-oauth
# Google matches this string character for character; a trailing slash fails.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=

# Client Secret — SERVER SIDE ONLY, set as a Supabase function secret, never
# here. The edge function needs the ID as well as the secret, because it does
# the code-for-token exchange itself:
#   npx supabase secrets set GOOGLE_CLIENT_ID=... GOOGLE_CLIENT_SECRET=...
# Found at: the same OAuth client, under "Client secrets"
#
# Note on scopes: youtube.readonly is a *sensitive* scope. While the consent
# screen is in Testing, only accounts listed under Audience → Test users can
# connect, and no review is needed. Publishing to Production requires Google
# verification, which takes days.


# ── Vercel, for rebuilding the website ────────
# SERVER SIDE ONLY, and not actually read from this file: it is a Supabase
# function secret. Set it with:
#   npx supabase secrets set VERCEL_DEPLOY_HOOK=https://api.vercel.com/v1/integrations/...
#
# Publishing a blog post or editing website copy asks the site to rebuild
# through this. Without it both still save, and the dashboard says so rather
# than implying the change is live. Treat it as a password: anybody holding it
# can spend build minutes at will.
# Found at: Vercel → website project → Settings → Git → Deploy Hooks
VERCEL_DEPLOY_HOOK=https://api.vercel.com/v1/integrations/deploy/...
