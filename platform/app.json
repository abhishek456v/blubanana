{
  "expo": {
    "name": "Blubanana",
    "slug": "blubanana",
    "scheme": "blubanana",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "in.blubanana.app"
    },
    "android": {
      "package": "in.blubanana.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#050506"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": []
        }
      ],
      "expo-asset",
      [
        "expo-audio",
        {
          "microphonePermission": "Blubanana uses your microphone to record voice notes for deal intake."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Blubanana uses your photo library to read deal screenshots you choose to import."
        }
      ],
      "expo-notifications",
      "expo-document-picker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "backgroundColor": "#050506"
          }
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "93a56c5d-149f-4061-ad8e-28c03715ef77"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/93a56c5d-149f-4061-ad8e-28c03715ef77"
    }
  }
}
