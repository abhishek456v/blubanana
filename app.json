{
  "expo": {
    "name": "CreatorDesk",
    "slug": "creatordesk",
    "scheme": "creatordesk",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ai.automitra.creatordesk"
    },
    "android": {
      "package": "ai.automitra.creatordesk",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#141210"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": []
        }
      ],
      "expo-asset",
      [
        "expo-audio",
        {
          "microphonePermission": "CreatorDesk uses your microphone to record voice notes for deal intake."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "CreatorDesk uses your photo library to read deal screenshots you choose to import."
        }
      ],
      "expo-notifications",
      "expo-document-picker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FDFBF9",
          "dark": {
            "backgroundColor": "#141210"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
